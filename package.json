{
  "name": "intervals-icu-api",
  "version": "0.3.1",
  "description": "TypeScript client for the intervals.icu API, generated from official OpenAPI spec",
  "keywords": [
    "api",
    "cycling",
    "intervals.icu",
    "openapi",
    "training",
    "typescript"
  ],
  "license": "MIT",
  "author": "Yerzhan Sagyt",
  "repository": {
    "type": "git",
    "url": "https://github.com/yerzhansa/intervals-icu-api.git"
  },
  "files": [
    "dist",
    "openapi.json",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "npm run schema:generate",
    "schema:fetch": "node scripts/schema-fetch.mjs",
    "schema:generate": "node scripts/schema-generate.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "schema:upstream-diff": "node scripts/schema-upstream-diff.mjs",
    "scan:sensitive": "node scripts/sensitive-data-check.mjs",
    "test:schema-diff": "node --test scripts/test-*.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:compat": "npm run build && tsc -p tests/compat/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "verify": "npm run scan:sensitive && npm run schema:check && npm run test:schema-diff && npm run typecheck && npm test && npm run test:compat && npm run check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "msw": "^2.13.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
